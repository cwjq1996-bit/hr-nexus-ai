# Copy this file to `.env` (which git ignores) and fill in your real values.
# Never commit `.env`.

APP_ENV=development
DEBUG=true

# SQLAlchemy URL for PostgreSQL using the psycopg 3 driver:
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/hris
