# Copy this file to `.env` (which git ignores) and fill in your real values.
# Never commit `.env`.

APP_ENV=development
DEBUG=true

# SQLAlchemy URL for PostgreSQL using the psycopg 3 driver:
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/hris

# Secret that signs login tokens. At least 32 characters, random, never shared.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS

# How long a login token stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=15
